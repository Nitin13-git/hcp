{
  "name": "hcp",
  "version": "0.1.0",
  "description": "Harness Context Protocol — a standard interface for agent harness state, verification, scope, and session lifecycle (TypeScript reference SDK).",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./reference": {
      "types": "./dist/src/reference/index.d.ts",
      "import": "./dist/src/reference/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nitin13-git/hcp",
    "directory": "ts"
  }
}
